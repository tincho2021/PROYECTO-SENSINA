rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Whitelisted public documents for IoT device sync
    match /telemetry/{document} {
      allow read, write: if true;
    }
    match /dispenser_status/{document} {
      allow read, write: if true;
    }
    match /fuel_transactions/{document} {
      allow read, write: if true;
    }
    match /alarms/{document} {
      allow read, write: if true;
    }
  }
}
